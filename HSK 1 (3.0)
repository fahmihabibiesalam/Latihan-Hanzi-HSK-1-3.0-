/* ====== SETUP ====== */
const WORDS = RAW.map((r,i)=>({id:i, w:r[0], p:r[1], pos:r[2], e:r[3]}));
const $ = s => document.querySelector(s);
const promptEl = $('#prompt'), subEl = $('#sub'), optionsEl = $('#options');
const feedbackEl = $('#feedback'), nextBtn = $('#next');
const scoreEl = $('#score'), totalEl = $('#total'), accEl = $('#acc'), streakEl = $('#streak');
const counterEl = $('#counter');

let mode = 'pinyin';
let queue = [];
let cur = null;
let answered = false;
let score = 0, total = 0, streak = 0, bestStreak = 0;
let mistakes = [];

const shuffle = a => { for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];} return a; };
const pick = a => a[Math.floor(Math.random()*a.length)];

/* ====== GAME ====== */
function nextQuestion(){
  if(queue.length === 0) queue = shuffle(WORDS.slice());
  const target = queue.pop();
  const qmode = mode === 'mix' ? pick(['pinyin','meaning','hanzi']) : mode;

  const answerOf = w => qmode === 'pinyin' ? w.p : qmode === 'meaning' ? w.e : w.w;
  const answer = answerOf(target);

  const confusable = w => qmode === 'hanzi'
      ? (w.p === target.p || w.e === target.e)
      : answerOf(w) === answer;

  const others = shuffle(WORDS.filter(w => w.id !== target.id && !confusable(w))).slice(0,3);
  const options = shuffle([target, ...others]);

  cur = { target, qmode, options };
  answered = false;
  render();
}

function label(w, qmode){
  return qmode === 'pinyin' ? w.p : qmode === 'meaning' ? w.e : w.w;
}

function render(){
  const { target, qmode, options } = cur;
  feedbackEl.className = 'feedback';
  feedbackEl.innerHTML = '';
  nextBtn.hidden = true;

  if(qmode === 'pinyin'){
    promptEl.textContent = target.w;
    promptEl.className = 'prompt hanzi';
    subEl.textContent = 'Bagaimana cara membacanya (pinyin)?';
  } else if(qmode === 'meaning'){
    promptEl.textContent = target.w;
    promptEl.className = 'prompt hanzi';
    subEl.textContent = 'Apa arti kata ini dalam bahasa Inggris?';
  } else {
    promptEl.textContent = target.p;
    promptEl.className = 'prompt pinyin';
    subEl.textContent = target.e + ' — pilih hanzi yang tepat';
  }

  optionsEl.innerHTML = '';
  options.forEach((w, i) => {
    const btn = document.createElement('button');
    btn.className = 'option' + (qmode === 'hanzi' ? ' hanzi-opt' : '');
    btn.innerHTML = '<span class="key">' + (i+1) + '</span><span class="txt"></span>';
    btn.querySelector('.txt').textContent = label(w, qmode);
    btn.addEventListener('click', () => choose(w, btn));
    optionsEl.appendChild(btn);
  });
}

function choose(chosen, btn){
  if(answered) return;
  answered = true;

  const correct = chosen.id === cur.target.id;
  total++;
  if(correct){ score++; streak++; bestStreak = Math.max(bestStreak, streak); }
  else { streak = 0; mistakes.push(cur.target); }

  Array.from(optionsEl.children).forEach((b, i) => {
    const w = cur.options[i];
    b.disabled = true;
    if(w.id === cur.target.id) b.classList.add('correct');
    else if(b === btn) b.classList.add('wrong');
  });

  const t = cur.target;
  feedbackEl.className = 'feedback show ' + (correct ? 'ok' : 'no');
  feedbackEl.innerHTML =
    '<div class="fb-title">' + (correct ? '✓ Benar!' : '✗ Kurang tepat') + '</div>' +
    '<div class="fb-detail">' +
      '<span class="d-hz"></span>' +
      '<span class="d-py"></span>' +
      '<span class="d-pos"></span>' +
      '<span class="d-en"></span>' +
    '</div>';
  feedbackEl.querySelector('.d-hz').textContent = t.w;
  feedbackEl.querySelector('.d-py').textContent = t.p;
  feedbackEl.querySelector('.d-pos').textContent = t.pos;
  feedbackEl.querySelector('.d-en').textContent = t.e;

  updateStats();
  nextBtn.hidden = false;
  nextBtn.focus({ preventScroll: true });
}

function updateStats(){
  scoreEl.textContent = score;
  totalEl.textContent = total;
  accEl.textContent = total ? Math.round(score / total * 100) + '%' : '–';
  streakEl.textContent = streak;
  counterEl.textContent = 'Soal ke-' + total + ' · Terbaik: ' + bestStreak + ' streak';
}

function resetSession(){
  queue = [];
  score = 0; total = 0; streak = 0; bestStreak = 0; mistakes = [];
  updateStats();
  nextQuestion();
}

/* ====== EVENTS ====== */
nextBtn.addEventListener('click', nextQuestion);

document.querySelectorAll('#modes button').forEach(b => {
  b.addEventListener('click', () => {
    document.querySelectorAll('#modes button').forEach(x => x.classList.remove('active'));
    b.classList.add('active');
    mode = b.dataset.mode;
    resetSession();
  });
});

$('#reset').addEventListener('click', resetSession);

document.addEventListener('keydown', e => {
  if(!answered && ['1','2','3','4'].includes(e.key)){
    const btn = optionsEl.children[Number(e.key) - 1];
    if(btn && !btn.disabled) btn.click();
  } else if(answered && (e.key === 'Enter' || e.key === ' ')){
    e.preventDefault();
    nextQuestion();
  }
});

/* start */
resetSession();
</script>
</body>
</html>
