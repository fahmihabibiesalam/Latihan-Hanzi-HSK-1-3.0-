    <div class="sub" id="sub">Bagaimana cara membacanya (pinyin)?</div>
    <div class="options" id="options"></div>
    <div class="feedback" id="feedback"></div>
    <button class="next" id="next" hidden>Lanjut →</button>
  </div>

  <div class="footer">
    <span id="counter">Soal ke-0</span>
    <button id="reset">Ulangi dari awal</button>
  </div>
</div>

